# Copy to web/.env.local and fill in. Next reads .env.local automatically;
# it is gitignored, unlike this file.

# The Atlas (or local) connection string, including the database password.
# Atlas: Database -> Connect -> Drivers -> Node.js, then replace <db_password>.
# Local mongod: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# If the app answers `querySrv ECONNREFUSED`, this machine's Node cannot do SRV
# lookups -- c-ares falls back to reporting 127.0.0.1 as the DNS server on some
# Windows setups, and nothing is listening there, even though Windows itself
# resolves the record fine. Use the seed-list form instead, which needs no SRV
# lookup because it goes through dns.lookup and the OS resolver:
#
#   nslookup -type=SRV _mongodb._tcp.<cluster>.mongodb.net 8.8.8.8   # the hosts
#   nslookup -type=TXT <cluster>.mongodb.net 8.8.8.8                 # the options
#
#   MONGODB_URI=mongodb://<user>:<password>@<h0>:27017,<h1>:27017,<h2>:27017/?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority

# Which database inside the cluster. Optional; defaults to `sc4sap`.
# Collections `users` and `sessions` are created on first use, with their
# indexes — see lib/mongo.ts.
MONGODB_DB=sc4sap

# Where the Fastify backend is, as seen from the Next server. Optional;
# defaults to http://127.0.0.1:3001. The browser never sees this — it only
# ever calls same-origin /api/*.
# SC4SAP_BACKEND=http://127.0.0.1:3001

# --- Outbound email (password reset) ---------------------------------------
# Resend API key. OPTIONAL: with no key the reset code is written to the
# `next dev` terminal instead of being emailed, which is enough to exercise
# the flow locally. Never run without a key anywhere the log is not private.
# RESEND_API_KEY=re_...

# Sender address. Optional; defaults to Resend's shared `onboarding@resend.dev`,
# which needs no domain verification but will only deliver to the address that
# owns the Resend account. Anything wider needs a verified domain here.
# RESEND_FROM=SC4SAP <noreply@your-domain.example>

# --- Google sign-in ---------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application". OPTIONAL: with neither set, the Continue with Google
# button explains that it is not configured and everything else still works.
#
# The client's Authorized redirect URI must be, character for character, what
# the callback builds from the request origin:
#
#     http://localhost:3000/api/auth/google/callback
#
# Google exempts localhost from its HTTPS requirement, so no deployment is
# needed to develop against this. Reaching the app over 127.0.0.1 produces a
# different string and would need its own entry. Several URIs can live on one
# client, so the deployed address is added alongside rather than instead.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# Only when this server cannot see the address the browser used — behind a
# proxy or a tunnel. Otherwise the callback derives it from the request.
# GOOGLE_REDIRECT_URI=https://sc4sap.example/api/auth/google/callback
