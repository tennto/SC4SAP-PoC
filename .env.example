# Copy to .env and fill in. The Agent SDK reads ANTHROPIC_API_KEY only —
# claude.ai / Claude Code OAuth login is NOT usable for third-party SDK apps.
ANTHROPIC_API_KEY=sk-ant-...

# Path to the sc4sap plugin repo (loaded via plugins: [{type:"local"}]).
# Vendored in-repo at ./plugin_module; point elsewhere only to use an
# external checkout.
SC4SAP_PLUGIN_PATH=./plugin_module

# Session working directory. Skills write artifacts to .sc4sap/-relative paths,
# so this is where those land. See Phase 1-4 (cwd strategy) in the plan.
SC4SAP_WORKSPACE=./workspace

# Model for PoC runs.
SC4SAP_MODEL=claude-sonnet-5

# Active SAP profile alias. Optional: the loader falls back to
# <plugin>/.sc4sap/active-profile.txt, but that path is gitignored by the
# plugin itself, so a fresh clone has no pointer and provisioning fails.
SC4SAP_PROFILE_ALIAS=KR-DEV
